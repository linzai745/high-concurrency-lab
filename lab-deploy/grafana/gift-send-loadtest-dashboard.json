    },
    {
      "type": "timeseries",
      "title": "Tomcat 线程数 (busy / current / max)",
      "description": "需开启 server.tomcat.mbeanregistry.enabled=true 才会有该指标",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "id": 24,
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*max.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*busy.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (instance) (tomcat_threads_busy_threads{application=\"$application\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} busy", "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (instance) (tomcat_threads_current_threads{application=\"$application\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} current", "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (instance) (tomcat_threads_config_max_threads{application=\"$application\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} max", "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tomcat 线程池使用率 (busy / max)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "id": 25,
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "red", "value": 0.9 }
          ] } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (instance) (tomcat_threads_busy_threads{application=\"$application\", instance=~\"$instance\"}) / clamp_min(sum by (instance) (tomcat_threads_config_max_threads{application=\"$application\", instance=~\"$instance\"}), 1)",
          "legendFormat": "{{instance}}", "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "数据库连接池 (HikariCP)",
