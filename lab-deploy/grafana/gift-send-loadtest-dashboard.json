      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "id": 23,
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2, "showPoints": "never" } },
